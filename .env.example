# =================================================================
# Talent Sphere Elevate - Master Environment Configuration Example
# =================================================================

# Backend Application Settings
PROJECT_NAME="Talent Sphere Elevate"
ENV="development"
PORT=8000

# Security & Authentication (JWT)
SECRET_KEY="your-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (SQLite / MySQL)
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="your-mysql-password"
DB_NAME="talent_sphere_elevate"
DATABASE_URL="sqlite:///./talent_sphere_elevate.db"

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR="./chroma_db"

# AI & LLM Integration (Groq Cloud API)
# Obtain an API key from https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="openai/gpt-oss-120b"

# Upload Storage Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# Email / SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_USE_TLS=True
SMTP_FROM_EMAIL="support@talentsphere.com"
SMTP_FROM_NAME="Talent Sphere Elevate"

# Frontend Configuration (Vite React Client)
VITE_API_BASE_URL="http://localhost:8000/api"
